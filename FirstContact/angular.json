{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "FirstContact": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": {
              "base": "dist/experience",
              "browser": ""
            },
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "FirstContact:build:production"
            },
            "development": {
              "buildTarget": "FirstContact:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "shared-lib": {
			"projectType": "library",
			"root": "projects/shared-lib",
			"sourceRoot": "projects/shared-lib/src",
			"prefix": "lib",
			"architect": {
				"build": {
					"builder": "@angular-devkit/build-angular:ng-packagr",
					"options": {
						"project": "projects/shared-lib/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/shared-lib/tsconfig.lib.prod.json"
						},
						"development": {
							"tsConfig": "projects/shared-lib/tsconfig.lib.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"tsConfig": "projects/shared-lib/tsconfig.spec.json",
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						]
					}
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": [
							"projects/shared-lib/**/*.ts",
							"projects/shared-lib/**/*.html"
						],
						"eslintConfig": "projects/shared-lib/eslint.config.js"
					}
				}
			}
		},
    "orders": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/orders",
			"sourceRoot": "projects/orders/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"progress": false,
						"tsConfig": "projects/orders/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/orders/public",
								"output": "."
							},
							"projects/orders/src/favicon.ico",
							"projects/orders/src/assets",
							"projects/orders/src/translations"
						],
						"styles": [
							"projects/orders/src/styles.scss"
						],
						"main": "projects/orders/src/main.ts",
						"outputPath": "dist/orders",
						"index": "projects/orders/src/index.html",
						"extraWebpackConfig": "projects/orders/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "32mb",
									"maximumError": "48mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "300kB",
									"maximumError": "500kB"
								}
							],
							"outputHashing": "all",
							"main": "projects/orders/src/main.mfe.ts",
							"extraWebpackConfig": "projects/orders/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": false
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "orders:build:production",
							"extraWebpackConfig": "projects/orders/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "orders:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"poll": 10000,
						"hmr": false,
						"port": 4204,
						"publicHost": "http://localhost:4204",
						"extraWebpackConfig": "projects/orders/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular/build:extract-i18n"
				},
				"test": {
					"builder": "@angular/build:karma",
					"options": {
						"tsConfig": "projects/orders/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/orders/public"
							}
						],
						"styles": [
							"projects/orders/src/styles.scss"
						]
					}
				}
			}
		}
  }
}
